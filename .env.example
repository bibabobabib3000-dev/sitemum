# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (free tier). Used by /api/lead and future API routes.
# When unset, /api/lead falls back to stub mode (logs payload to stdout).
DATABASE_URL=

# Cloudflare R2 (video/audio storage) — populated in LMS phase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Telegram bot — populated in PR #3
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Email (Resend) — populated when transactional email is wired
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments — wired after the full site is ready
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET=
MONOPAY_TOKEN=

# Zoom — populated in PR #6
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET=

# Analytics — populated in PR #8
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
