# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon Postgres (free tier). Used by /api/lead and future API routes.
# When unset, /api/lead falls back to stub mode (logs payload to stdout).
DATABASE_URL=

# Cloudflare R2 (video/audio storage) — populated in LMS phase
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Telegram bot — PR #3
# Token from @BotFather. Required for any outgoing TG calls. When unset,
# the bot integration is a silent no-op and /api/lead still works.
TELEGRAM_BOT_TOKEN=
# Shared secret used to verify incoming webhook requests from Telegram.
# When set, /api/telegram/webhook rejects any request whose
# X-Telegram-Bot-Api-Secret-Token header does not match.
TELEGRAM_WEBHOOK_SECRET=
# Optional: numeric chat_id to receive admin notifications about new leads.
# Get yours by messaging @userinfobot in Telegram. When unset, admin notifs
# are skipped.
TELEGRAM_ADMIN_CHAT_ID=
# Bot username without @. Used to build the t.me deep link button on
# the thank-you page and the lead-form success state. When empty the
# CTA is hidden.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=your_bot

# Auth + transactional email (PR #8).
# RESEND_API_KEY — server API key from resend.com.
# EMAIL_FROM     — verified "from" address, e.g. "RESOUL <login@resoul.app>".
# AUTH_COOKIE_SECRET — at least 32 random bytes (e.g. `openssl rand -hex 32`).
# Without any of these the magic-link flow degrades gracefully:
#   - missing RESEND_API_KEY/EMAIL_FROM → /api/auth/request-link returns
#     { ok:true, data:{ sent:false, reason:"resend_not_configured" } }
#     and we log the raw link to console for dev.
#   - missing AUTH_COOKIE_SECRET        → /api/auth/request-link returns 503
#     and /api/auth/verify redirects to /login?status=disabled.
RESEND_API_KEY=
EMAIL_FROM=
AUTH_COOKIE_SECRET=

# Payments — WayForPay (PR #7).
# When any of WFP_* is empty, /api/pay/wfp/create returns 503 and the lead
# form falls back to its old thank-you flow regardless of NEXT_PUBLIC_PAY_AFTER_LEAD.
WFP_MERCHANT_LOGIN=
WFP_MERCHANT_SECRET=
WFP_DOMAIN=

# Payments — MonoPay (PR #7).
# When MONO_TOKEN is empty, /api/pay/mono/create returns 503.
MONO_TOKEN=

# Set to "1" to auto-redirect users to WayForPay checkout after a successful
# lead submit (only for productSlug=="level-0"). Default ("0" / unset) keeps
# the existing thank-you screen.
NEXT_PUBLIC_PAY_AFTER_LEAD=

# Zoom — Live event flow (PR #6).
# Server-to-Server OAuth credentials from a Zoom Marketplace app.
# When any of these are unset, src/lib/zoom/* helpers are not invoked and the
# live event page still renders (countdown only, no join link).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Secret Token from the same Marketplace app under "Feature → Event Subscriptions".
# Used to (a) answer Zoom's URL validation challenge and (b) verify each
# webhook delivery via HMAC-SHA256. When unset, /api/zoom/webhook returns 503
# on the validation handshake and accepts everything else without verification
# (dev-only behaviour).
ZOOM_WEBHOOK_SECRET_TOKEN=

# Vercel cron secret. Set this in Vercel Project Settings → Cron Jobs to a
# random string and store the same value here. /api/cron/zoom-reminders
# rejects requests whose Authorization header does not match. Leave empty in
# local dev — the route will then only allow requests carrying the
# `x-vercel-cron` header.
CRON_SECRET=

# Meta Pixel + Conversions API (PR #5)
# Pixel ID is public (used by the browser-side fbq init) and is safe to ship
# in the bundle. When unset, <PixelScript /> renders nothing and the
# /api/capi/lead route returns { skipped: true }.
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token (server-side only). Generated in Meta Events
# Manager → Settings → Generate access token. NEVER prefix with NEXT_PUBLIC_.
META_CAPI_TOKEN=
# Optional Test Event Code (e.g. TEST12345) from Events Manager → Test events.
# When set, every CAPI event is tagged so it appears in the Test events tab
# instead of polluting production data.
META_PIXEL_TEST_CODE=

# Analytics — populated in later PR
NEXT_PUBLIC_GA4_ID=
