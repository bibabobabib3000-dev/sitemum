{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "RESOUL",
  "short_name": "RESOUL",
  "description": "Цифрова інфраструктура RESOUL METHOD v1.0 — Immersion Week, Foundation, Integration. Уроки, домашні, прогрес у кишені.",
  "lang": "uk",
  "dir": "ltr",
  "start_url": "/uk/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["education", "lifestyle", "health"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
